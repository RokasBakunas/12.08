// Prisma schema covering key entities for the job portal
// Target database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          String
  status        String
  createdAt     DateTime @default(now())
  permissions   Json
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  candidateProfile ProfileCandidate?
  employerProfiles ProfileEmployer[]
  applications  Application[] @relation("CandidateApplications")
  auditLogs     AuditLog[]    @relation("AuditActor")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  description String
  website     String
  logoUrl     String
  createdAt   DateTime     @default(now())
  status      String
  jobs        JobPost[]
  users       ProfileEmployer[]
  reports     Report[]
}

model ProfileCandidate {
  id        String      @id @default(uuid())
  userId    String      @unique
  contact   Json
  settings  Json
  user      User        @relation(fields: [userId], references: [id])
  cvs       CvVersion[]
}

model ProfileEmployer {
  id        String  @id @default(uuid())
  userId    String
  companyId String
  role      String
  user      User    @relation(fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
}

model JobPost {
  id              String        @id @default(uuid())
  companyId       String
  title           String
  description     String
  salaryMin       Int?
  salaryMax       Int?
  location        String
  remoteType      String
  employmentType  String
  experienceLevel String
  status          String
  publishedAt     DateTime?
  expiresAt       DateTime?
  premiumFlags    String[]
  tags            JobPostTag[]
  applications    Application[]
  company         Company       @relation(fields: [companyId], references: [id])
  reports         Report[]
}

model JobTag {
  id    String       @id @default(uuid())
  name  String       @unique
  posts JobPostTag[]
}

model JobPostTag {
  jobId String
  tagId String
  job   JobPost @relation(fields: [jobId], references: [id])
  tag   JobTag  @relation(fields: [tagId], references: [id])
  @@id([jobId, tagId])
}

model CvVersion {
  id           String         @id @default(uuid())
  candidateId  String
  jsonData     Json
  fileUrl      String?
  createdAt    DateTime       @default(now())
  candidate    ProfileCandidate @relation(fields: [candidateId], references: [id])
  applications Application[]
}

model Application {
  id           String   @id @default(uuid())
  jobPostId    String
  candidateId  String
  cvVersionId  String
  coverLetter  String?
  status       String
  viewedAt     DateTime?
  createdAt    DateTime @default(now())
  job          JobPost  @relation(fields: [jobPostId], references: [id])
  candidate    User     @relation("CandidateApplications", fields: [candidateId], references: [id])
  cv           CvVersion @relation(fields: [cvVersionId], references: [id])
}

model MessageThread {
  id          String    @id @default(uuid())
  jobPostId   String
  candidateId String
  employerId  String
  messages    Message[]
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  thread    MessageThread @relation(fields: [threadId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  query     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  job       JobPost  @relation(fields: [jobId], references: [id])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id])
  job        JobPost? @relation(fields: [targetId], references: [id])
  company    Company? @relation(fields: [targetId], references: [id])
}

model PaymentPlan {
  id         String  @id @default(uuid())
  name       String
  priceCents Int
  currency   String
  features   Json
  orders     Order[]
  subscriptions Subscription[]
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  planId     String
  amount     Int
  status     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  plan       PaymentPlan @relation(fields: [planId], references: [id])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    String
  startedAt DateTime @default(now())
  endsAt    DateTime?
  user      User     @relation(fields: [userId], references: [id])
  plan      PaymentPlan @relation(fields: [planId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json
  after      Json
  timestamp  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  payload   Json
  status    String
  createdAt DateTime @default(now())
}

@@index([title, location])
@@index([status])
