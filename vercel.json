{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/main.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "apps/api/src/main.ts" },
    { "src": "/ready", "dest": "apps/api/src/main.ts" },
    { "src": "/flights/(.*)", "dest": "apps/api/src/main.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "apps/web" }
  ],
  "env": {}
}
